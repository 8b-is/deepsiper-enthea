{
  "name": "@deepseek-ai/dsh-quant-reference",
  "description": "Reference (software) provider for the DeepSeek Harness quantization capability seam (ctx.quant) — registers a pure-software backend matching entheai crates/ternary group ternary quantize semantics plus a dense ternary GEMM over dequantized weights, bounded by maxOutputBytes",
  "version": "0.3.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8b-is/deepsiper-enthea.git",
    "directory": "packages/quant/quant-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-quant": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-quant": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "typescript": "^6.0.3"
  }
}
